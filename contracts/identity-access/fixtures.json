  "expectations": [
    {
      "id": "csrf.binding",
      "operation": "getIdentityCsrf",
      "expected": "Cookie/header server binding; no refresh/idle rotation. Logout without refresh cookie still requires server-bound pre-auth CSRF and exact Origin; repeat returns204 without restoring session.",
      "verification": "DECLARATIVE_NOT_RUNTIME_EXECUTED"
    },
    {
      "id": "refresh.concurrent",
