# Documentation template only. The launcher generates private files under .demo/postgres.
ELOGISTICS_SECRETS_DIR=/absolute/path/to/ignored/postgres/secrets
PG_DB_URL=jdbc:postgresql://127.0.0.1:5433/elogistics_dev
PG_RUNTIME_USER=elogistics_runtime
PG_RUNTIME_PASSWORD=replace_with_private_runtime_password
PG_MIGRATOR_USER=elogistics_migrator
PG_MIGRATOR_PASSWORD=replace_with_private_migrator_password
PG_OWNER_ROLE=elogistics_owner
