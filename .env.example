# Portable Compose: no secret values belong here. Keys/passwords/certificates are
# generated once into isolated named volumes. The legacy host settings below
# are independent and are not consumed by root compose.yaml.
COMPOSE_PROJECT_NAME=argopost-baseline
ARGOPOST_WEB_PORT=5443
ARGOPOST_MAIL_PORT=8025

# Legacy host config template — placeholders ONLY.
APP_PROFILE=local
DB_URL=jdbc:postgresql://localhost:5432/elogistics
DB_USERNAME=REPLACE_ME
DB_PASSWORD=REPLACE_WITH_LOCAL_SECRET
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USERNAME=REPLACE_ME
RABBITMQ_PASSWORD=REPLACE_WITH_LOCAL_SECRET
VNPAY_ENV=sandbox
VNPAY_TMNCODE=REPLACE_WITH_SANDBOX_VALUE
VNPAY_HASH_SECRET=REPLACE_WITH_SANDBOX_SECRET
MAP_PROVIDER=UNDECIDED
POD_STORAGE_PROVIDER=UNDECIDED
TZ=Asia/Ho_Chi_Minh
