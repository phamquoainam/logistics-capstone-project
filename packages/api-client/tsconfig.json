{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": [],
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"]
}
