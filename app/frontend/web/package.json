{
  "name": "elogistics-demo-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
